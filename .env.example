# Copy to .env and fill in real values. Never commit .env itself.

# --- Database (MySQL 8+ / MariaDB 10.4+) ---
# Create the schema with `npm run db:setup`, then load demo data with `npm run db:seed`.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=centermanager
DB_USERNAME=
DB_PASSWORD=
DB_POOL_MAX=10
# Set to true only when the server presents a certificate signed by DATABASE_CA_CERT
DATABASE_SSL=false
# PEM contents of the CA that signed the database certificate (required when DATABASE_SSL=true)
DATABASE_CA_CERT=

# --- Cache / rate limiting (optional, falls back to the database) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Server ---
PORT=2500
NEXT_PUBLIC_APP_URL=http://localhost:2500
NEXT_PUBLIC_BASE_URL=http://localhost:2500
# Leave empty when served at the site root; set e.g. /Centre behind a sub-path proxy
NEXT_PUBLIC_BASE_PATH=

# --- Email (SendGrid) ---
SENDGRID_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
DEFAULT_GST_RATE=18

# --- File storage ---
UPLOAD_BASE_PATH=

# --- Uploads: virus scanning ---
VIRUS_SCAN_ENABLED=false
VIRUS_SCAN_URL=

# --- SMS (optional — student OTP + other transactional SMS) ---
# When SMS_API_URL is set, student OTP tries SMS first, then email, then
# development/dev-otp fallback (NODE_ENV=development or STUDENT_OTP_DEV_MODE=true).
# Provider contract: POST JSON { mobile, message, sender, key } to SMS_API_URL.
# Auth header: Authorization: Bearer <SMS_API_KEY> when SMS_API_KEY is set.
# Set SMS_PROVIDER=console to log only (never counts as delivered).
# Leave SMS_API_URL empty to skip SMS and use email/dev OTP fallbacks.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_PROVIDER=auto
# Force OTP value in API responses when SMS/email both fail (also on in development)
STUDENT_OTP_DEV_MODE=false

# --- Optional external course API (enquiry course types, course comparison) ---
# Leave empty to disable; the site falls back to the local course catalog.
NEXT_PUBLIC_PRELOGIN_API_URL=

# --- Windows dev workaround ---
WIN32_CLEAN_NEXT_ON_START=1

# --- OpenRouter (site chatbot + student AI Tutor) ---
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_FALLBACK_MODELS=google/gemini-2.5-flash,qwen/qwen3.7-flash
OPENROUTER_APP_NAME=EduSphere Academy Center Manager
