{
  "name": "center-manager",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=4096 server.js",
    "dev:fresh": "node scripts/kill-port.js && node scripts/rm-next.js && node --max-old-space-size=4096 server.js",
    "build": "node scripts/print-base-path.js && node scripts/rm-next.js && next build && node scripts/verify-build-base-path.js",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy-production.ps1",
    "start": "node server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:smoke": "node scripts/smoke-api-contract.js",
    "setup-assets": "node scripts/setup-assets.js",
    "cron:installment-reminders": "node scripts/send-installment-reminders.js",
    "db:setup": "node scripts/mysql/apply-schema.js",
    "db:seed": "node scripts/mysql/seed-demo-data.js",
    "db:reset": "node scripts/mysql/apply-schema.js && node scripts/mysql/seed-demo-data.js",
    "db:check-sql": "node scripts/mysql/scan-pg-sql.js --explain",
    "test:db": "vitest run tests/unit/db-mysql",
    "db:meta": "node scripts/mysql/generate-schema-meta.js",
    "db:migrate": "node scripts/mysql/apply-enrollment-migration.js",
    "reminders:run": "node scripts/send-installment-reminders.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@sendgrid/mail": "^8.1.6",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "fflate": "^0.8.3",
    "isomorphic-dompurify": "^3.22.0",
    "jose": "^6.2.8",
    "jsonwebtoken": "^9.0.2",
    "katex": "^0.18.3",
    "lucide-react": "^0.562.0",
    "mysql2": "^3.11.3",
    "next": "^14.0.0",
    "next-themes": "^0.2.1",
    "pdf-lib": "^1.17.1",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.85.0",
    "recharts": "^3.10.1",
    "redis": "^6.2.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.16",
    "dotenv": "^16.6.1",
    "eslint": "^8.54.0",
    "eslint-config-next": "^14.0.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.2",
    "vitest": "^4.1.10"
  }
}
